{
  "compilerOptions": {
    "target": "es6", // Use ES6 as the target (if possible, for better performance and modern features)
    "lib": [
      "esnext"
    ],
    "allowJs": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "commonjs", // Set module to commonjs for Node.js compatibility
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,  // Ensure TypeScript emits compiled JS files
    "outDir": "./dist", // Set the output directory for compiled files
    "jsx": "react",  // <-- Make sure this is set to "react"
    "types": [] // You likely don’t need React types for a backend app
  },
  "include": [
    "src/**/*" // Ensure all TypeScript files in the src directory are included
  ]
}
